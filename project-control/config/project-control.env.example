PROJECT_CONTROL_VERSION=0.1.0
PROJECT_CONTROL_HOST=0.0.0.0
PROJECT_CONTROL_PORT=9090
PROJECT_CONTROL_ACCESS_TOKEN=
PROJECT_CONTROL_DATA_DIR=/var/lib/project-control
PROJECT_CONTROL_EXECUTOR_SOCKET=/run/project-control/executor.sock
PROJECT_CONTROL_PYTHON_BIN=/usr/bin/python3
PROJECT_CONTROL_MAX_UPLOAD_BYTES=17179869184
PROJECT_CONTROL_COMMAND_TIMEOUT_MS=1800000
# false: подпись release package необязательна, но SHA-256/native manifests проверяются.
# true: принимаются только Ed25519-подписанные .f2re.zip с доверенным public key.
PROJECT_CONTROL_REQUIRE_SIGNATURE=false
PROJECT_CONTROL_TRUSTED_KEYS_DIR=/etc/project-control/trusted-keys
